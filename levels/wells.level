# Level — Well, well, well: a hand-drawn cavern with three vertical wells
# sunk into its floor, each ending in a landing base.
#
#   cavern (x -26..140, y 0..30, uneven roof + floor humps)
#     │ start platform at x = 0
#     ├─ well 1 @ x 30  — winding: three smooth turns,  40 m deep
#     ├─ well 2 @ x 72  — lightning: a KISS-logo bolt,   50 m deep
#     └─ well 3 @ x 118 — almost straight, 90 m deep (the long haul)
#
# TIME-scored: the clock starts at your first input, the HUD counts bases
# x/3, and touching down on the last unvisited base ends the run — lowest
# time wins. The bases refuel, the neutral start platform does not, so the
# wells double as fuel stops on the way back up.
#
# Well 1 is three half-waves of a sine, so it swings east, west, then east
# again; well 2's strokes are raked ~65 deg off vertical, which is what makes
# its reversals the acute hairpins of the KISS logo's S rather than a gentle
# slalom. Every well ends in dead-vertical shaft so there is a clean
# horizontal floor to land on, and leaves its mouth vertical too (the walls
# are perpendicular offsets of the centre line, so a shaft already leaning at
# the mouth would cut the opening diagonally). The corridor therefore keeps
# its width however steeply the shaft leans; the basement is vertical rock
# strips between the wells plus a plug under each well floor — overlapping
# polygons, buried edges unreachable, exactly like The Hollows' frame.
name = Well, well, well
description = Three wells, three bases. Down and up each, against the clock
scoring = time
shafts = off
obstacles = off

# Neutral start platform in the cavern — the launch spot, NOT one of the
# bases to visit (and it does not refuel).
start = 0,0.4

# The three bases, one on each well floor: winding, lightning, deep.
pad = 30,-39.6
pad = 64,-49.6
pad = 119.16,-89.6

# Basement strip: west wall to well 1.
